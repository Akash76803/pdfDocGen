PORT=8787
HOST=127.0.0.1
# Optional override. By default the API reads the same Tauri AppData template folder used by the desktop app.
# Windows default: %APPDATA%/com.documenttool.app/templates
API_TEMPLATE_DIR=
# Bundled/development fallback used for sample templates such as example-invoice.
API_FALLBACK_TEMPLATE_DIR=./data/templates
API_MAX_BODY_MB=20
API_ABSOLUTE_MAX_BODY_MB=50
