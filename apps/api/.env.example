PORT=8787
HOST=127.0.0.1
# Optional override. By default the API reads the same Tauri AppData template folder used by the desktop app.
# Windows default: %APPDATA%/com.documenttool.app/templates
API_TEMPLATE_DIR=
# Bundled/development fallback used for sample templates such as example-invoice.
API_FALLBACK_TEMPLATE_DIR=./data/templates
API_MAX_BODY_MB=20
API_ABSOLUTE_MAX_BODY_MB=50
API_GENERATION_TIMEOUT_MS=240000
API_ABSOLUTE_GENERATION_TIMEOUT_MS=295000
API_MAX_BATCH_DOCUMENTS=100
API_ABSOLUTE_MAX_BATCH_DOCUMENTS=500
# Persistent GCP driver (required only when repository mode is cloud)
API_TEMPLATE_REPOSITORY_MODE=filesystem
API_GCP_TEMPLATE_BUCKET=
API_GCP_FIRESTORE_DATABASE=(default)
API_GCP_TEMPLATE_PREFIX=document-builder/templates
API_GCP_ASSET_PREFIX=document-builder/assets

# CLOUD-5 authentication (disabled for local backward compatibility; enable explicitly in hosted environments)
API_AUTH_MODE=disabled
# Required only when API_AUTH_MODE=static-bearer. Do not commit a real secret.
API_AUTH_STATIC_BEARER_TOKEN=
